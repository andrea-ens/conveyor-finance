# Spacemail (Spaceship)
# Local .env.local: wrap SMTP_PASS in double quotes if it contains # or $
# Vercel: paste the password with no quotes. Redeploy after adding variables.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=careers@conveyor.finance
SMTP_PASS="your-mailbox-password"
SMTP_FROM=careers@conveyor.finance
CAREERS_EMAIL=careers@conveyor.finance
HELLO_EMAIL=hello@conveyor.finance
